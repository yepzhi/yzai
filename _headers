  Expires: 0
  Content-Security-Policy: default-src 'self' https: blob: data:; media-src 'self' https: blob: data:; img-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https: blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com data:; connect-src * 'unsafe-inline' blob: data: http: https: ws: wss:;
